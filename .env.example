# Never put raw secrets into prompts or YAML manifests.
# Store them with: sovereign secret set <name>
SOVEREIGN_HOME=./state
SOVEREIGN_CONFIG=./configs/system.yaml
SOVEREIGN_STATE_DIR=./state
# On this workstation, launchers set the following three to WSL-native storage.
SOVEREIGN_MODEL_DIR=./models
SOVEREIGN_CACHE_DIR=./cache
SOVEREIGN_RUNTIME_DIR=./runtimes
SOAI_DATA_HOME=~/.local/share/sovereign-ai
HF_HOME=./cache/huggingface
HF_TOKEN=
